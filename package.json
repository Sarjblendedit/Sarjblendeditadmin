{
  "name": "sarj-blended-it",
  "version": "0.1.0",
  "description": "Premium mobile-barber booking platform",
  "private": true,
  "workspaces": [
    "apps/admin",
    "apps/customer"
  ],
  "scripts": {
    "dev:admin": "npm --workspace=apps/admin run dev",
    "dev:customer": "npm --workspace=apps/customer run dev",
    "build:admin": "npm --workspace=apps/admin run build",
    "build:customer": "npm --workspace=apps/customer run build",
    "start:admin": "npm --workspace=apps/admin run start",
    "start:customer": "npm --workspace=apps/customer run start",
    "lint": "npm --workspace=apps/admin run lint && npm --workspace=apps/customer run lint"
  }
}
