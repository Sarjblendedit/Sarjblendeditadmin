{
  "expo": {
    "name": "SARJ BLENDED IT",
    "slug": "sarj-blended-it",
    "scheme": "sarjblendedit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sarjblendedit.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationWhenInUsePermission": "Allow SARJ BLENDED IT to use your location during appointments.",
          "locationAlwaysAndWhenInUsePermission": "Allow SARJ BLENDED IT to share your live location during an active appointment."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SARJ BLENDED IT to use your haircut inspiration photo."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#d9b950",
          "defaultChannel": "booking-updates"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd47b117-4b17-4779-9b44-001f72526ef2"
      }
    },
    "owner": "sarjblendedit"
  }
}
